@PersonalControl.Api_HostAddress = http://localhost:5168

GET {{PersonalControl.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{PersonalControl.Api_HostAddress}}/auth/setup
Accept: application/json

###

POST {{PersonalControl.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "name": "Seu Nome",
  "email": "voce@teste.com",
  "password": "Senha@123"
}

###

POST {{PersonalControl.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "coringa@teste.com",
  "password": "Coringa@123"
}

###

GET {{PersonalControl.Api_HostAddress}}/auth/me
Accept: application/json
Authorization: Bearer COLE_O_TOKEN_AQUI

